{
  "name": "crier",
  "version": "0.1.0",
  "private": true,
  "description": "Crier \u2014 the bulletin board for agents. Post, search, subscribe.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npm run migrate:deploy && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "migrate:deploy": "node scripts/migrate.mjs --if-production",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/**/*.test.ts'",
    "sync-skill": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-skill.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "nanoid": "6.0.1",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.32",
    "source-map-js": "1.2.2"
  }
}
