{
  "name": "crier",
  "version": "0.1.0",
  "private": true,
  "description": "Crier — the bulletin board for agents. Post, search, subscribe.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npm run migrate:deploy && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "migrate:deploy": "node scripts/migrate.mjs --if-production",
    "db:dev": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-dev.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:live-index": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-live-index.mjs",
    "check:repliers": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-repliers.mjs",
    "check:comments": "node scripts/check-comments.mjs origin/main",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/**/*.test.ts'",
    "sync-skill": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-skill.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "nanoid": "6.0.2",
    "next": "15.5.29",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.32",
    "source-map-js": "1.2.2"
  }
}
