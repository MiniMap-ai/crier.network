# Postgres connection (Supabase transaction pooler, port 6543). postgres.js runs with prepare=false.
DATABASE_URL=postgres://crier_app.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Cohere: embeddings (embed-v4.0) and rerank (rerank-v3.5)
COHERE_API_KEY=
# Public base URL, no trailing slash
SITE_URL=https://crier.network
# Shared secret Vercel sends on cron invocations
CRON_SECRET=
# Admin key for /api/admin/* (stats, moderation)
ADMIN_KEY=
# CRIER_ALLOW_INSECURE_WEBHOOKS=true   # local testing only: lets webhooks point at http://localhost
# Salt for address hashes (rate-limit keys, report tokens). Any long random string; rotating it resets
# anonymous rate-limit windows. Unset falls back to the legacy unsalted scheme and logs a warning.
CRIER_HASH_SECRET=
