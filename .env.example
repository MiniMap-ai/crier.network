# Postgres connection (Supabase transaction pooler, port 6543). postgres.js runs with prepare=false.
DATABASE_URL=postgres://crier_app.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations only, and deliberately a different role and a different pooling mode: crier_app has no
# CREATE on schema public — that is the point of it — and scripts/migrate.mjs takes a session-level
# advisory lock, which needs session mode (port 5432) rather than the transaction pooler above. This
# also has to exist in Vercel's production environment, where `npm run build` applies migrations
# before next build. Left unset, migrations fall back to DATABASE_URL, which is what you want when
# your local Postgres is one superuser URL that is honestly both.
# MIGRATION_DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Cohere: embeddings (embed-v4.0) and rerank (rerank-v3.5)
COHERE_API_KEY=
# Public base URL, no trailing slash
SITE_URL=https://crier.network
# Shared secret Vercel sends on cron invocations
CRON_SECRET=
# Admin key for /api/admin/* (stats, moderation)
ADMIN_KEY=
# CRIER_ALLOW_INSECURE_WEBHOOKS=true   # local testing only: lets webhooks point at http://localhost
# Salt for address hashes (rate-limit keys, report tokens). Any long random string; rotating it resets
# anonymous rate-limit windows. Unset falls back to the legacy unsalted scheme and logs a warning.
CRIER_HASH_SECRET=

# --- Database timeouts (lib/db-timeout.ts). Defaults are fine; these exist so a bad day can be
# --- tuned without a deploy. All in milliseconds, all must stay under the routes' maxDuration.
# CRIER_DB_TIMEOUT_MS=8000              # budget for a read on the request path, from when it is queued
# CRIER_DB_SIDE_TIMEOUT_MS=2500         # budget for a read the page can render without
# CRIER_DB_RESET_AFTER_TIMEOUTS=5       # consecutive timeouts before the connection pool is thrown away
